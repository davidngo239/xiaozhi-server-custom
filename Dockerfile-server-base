# Dockerfile-server-base
# Hình ảnh cơ sở, bao gồm các phần phụ thuộc hệ thống và gói Python
FROM python:3.10-slim

# Cài đặt phụ thuộc hệ thống
RUN apt-get update && \
    apt-get install -y --no-install-recommends libopus0 ffmpeg locales && \
    sed -i '/zh_CN.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Định cấu hình pip để sử dụng nguồn nhân bản trong nước (Đám mây Alibaba) và đặt thời gian chờ và thử lại
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip config set global.trusted-host mirrors.aliyun.com && \
    pip config set global.timeout 120 && \
    pip config set install.retries 5

# Đặt biến môi trường để đảm bảo mã hóa ký tự chính xác
ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    PYTHONIOENCODING=utf-8

WORKDIR /opt/xiaozhi-esp32-server

# Sao chép các yêu cầu.txt
COPY main/xiaozhi-server/requirements.txt .

# Cài đặt phụ thuộc Python
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt --default-timeout=120 --retries 5